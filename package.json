{
  "name": "margin-local-highlighter",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "description": "Local-first web highlighter for Chrome, Edge, Brave and Firefox",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "package": "node scripts/package.mjs",
    "lint": "eslint src scripts tests eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "node scripts/brand.mjs",
    "test:native": "node tests/native-flows.mjs",
    "test:languages": "node tests/native-language-errors.mjs",
    "configure:google": "node scripts/configure-google.mjs",
    "test:drive": "node tests/drive-e2e.mjs",
    "build:edge": "node scripts/build.mjs --target=edge",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "npm run build && npm run build:edge && npm run build:brave && npm run build:firefox",
    "test:firefox": "node tests/firefox-e2e.mjs",
    "test:firefox:drive": "node tests/firefox-drive.mjs",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "build:brave": "node scripts/build.mjs --target=brave",
    "package:public": "node scripts/package.mjs --public",
    "verify:release": "node scripts/verify-release.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:experience": "node tests/experience-e2e.mjs",
    "test:organization": "node tests/organization-e2e.mjs",
    "test:research": "node tests/research-e2e.mjs",
    "test:drive:public": "node tests/public-drive.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "harper.js": "3.0.0",
    "marked": "^18.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "sharp": "^0.35.5",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "multimatch": "^8.0.0",
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saeidshirazi/margin-web-highlighter.git"
  },
  "homepage": "https://github.com/saeidshirazi/margin-web-highlighter",
  "bugs": {
    "url": "https://github.com/saeidshirazi/margin-web-highlighter/issues"
  }
}
