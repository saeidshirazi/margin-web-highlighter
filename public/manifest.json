{
  "manifest_version": 3,
  "name": "Margin — Local Web Highlighter",
  "short_name": "Margin",
  "version": "0.9.7",
  "minimum_chrome_version": "150",
  "description": "Highlight, annotate and export your research. Local storage with optional Google Drive sync. No subscriptions or tracking.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "sidePanel",
    "identity",
    "alarms"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Margin",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "library.html#settings",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "highlight": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Highlight selected text"
    },
    "quick": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Toggle quick highlight mode"
    },
    "library": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Open your local library"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'"
  }
}
